{
  "mcpServers": {
    "pal": {
      "command": "bash",
      "args": [
        "-c",
        "exec bash \"${CLAUDE_PROJECT_DIR:-$PWD}/pal/start.sh\""
      ],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "DEFAULT_MODEL": "auto",
        "DISABLED_TOOLS": "analyze,refactor,testgen,secaudit,docgen,tracer"
      }
    }
  }
}
